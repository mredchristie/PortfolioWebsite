    {
      "id": "3iUDbf0sYxC3DSJSgGfUF",
      "type": "text",
      "x": 4271.199131740151,
      "y": 1745.8829741537738,
      "width": 237.19984436035156,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 879236196,
      "version": 220,
      "versionNonce": 1032761188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762526149730,
      "link": null,
      "locked": false,
      "text": "Access and read user\ndata from the database\nto compare credentials\nentered to login against\nthose of the database.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Ej2gf9c2m_o9XBTQO8r1D",
      "originalText": "Access and read user data from the database to compare credentials entered to login against those of the database.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RX6pWD_8dTo_xQ6oUjb1Y",
      "type": "text",
      "x": 6150.718320706954,
      "y": 1625.959263557704,
      "width": 656.2171062967382,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 191488476,
      "version": 800,
      "versionNonce": 1769148644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762527111643,
      "link": null,
      "locked": false,
      "text": "Entire UI - Interfaces with all components.\n\nGame Library/Category- pulls data from the database, uses search\nand filter for querying, sends game details to UI.\n\nAccessibility settings - Saved to user profile data table in the\ndatabase. Sent to UI to customize experience.\n\nSearch and filter - queries game library/category. Accesses\nDatabase for results. \n\nReview and Rating - Writes to/reads from database.\nDisplays UI; attatched to ghames in Games library.\n\nUser Profile data - Written/read via Sign in API and Database\nManages accessibility preferences.\n\nSpeech to text API - Listens/applies to UI\nMay interact with Accessibility settings\n\nSign in API - Manages user login; interacts with Security\ncomponent\nAccesses User profile data in Database\n \nSecurity component - Governs access/permissions for APIs,\ndatabase, account management\n\nDatabase - Central data store for all content (games, users,\nreviews, accessibility preferences, ratings).\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entire UI - Interfaces with all components.\n\nGame Library/Category- pulls data from the database, uses search and filter for querying, sends game details to UI.\n\nAccessibility settings - Saved to user profile data table in the database. Sent to UI to customize experience.\n\nSearch and filter - queries game library/category. Accesses Database for results. \n\nReview and Rating - Writes to/reads from database.\nDisplays UI; attatched to ghames in Games library.\n\nUser Profile data - Written/read via Sign in API and Database\nManages accessibility preferences.\n\nSpeech to text API - Listens/applies to UI\nMay interact with Accessibility settings\n\nSign in API - Manages user login; interacts with Security component\nAccesses User profile data in Database\n \nSecurity component - Governs access/permissions for APIs, database, account management\n\nDatabase - Central data store for all content (games, users, reviews, accessibility preferences, ratings).\n\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
